{
  "groups": [
    {
      "id": "phases",
      "label": "Watering phases",
      "help": "How each phase waters: when it starts, the shot sizes and the time between shots."
    },
    {
      "id": "safety",
      "label": "Safety and holds",
      "help": "The switches that stop or hold watering, and the limits on each shot and each day."
    },
    {
      "id": "feed",
      "label": "Dosing and feed",
      "help": "The EC steer, the EC targets and the source-water gate."
    },
    {
      "id": "ai",
      "label": "AI assistant",
      "help": "What the AI assistant may change in this room."
    },
    {
      "id": "alerts",
      "label": "Alerts",
      "help": "What the notifications say."
    },
    {
      "id": "display",
      "label": "Display panels",
      "help": "How the dashboard shows the room. These change no watering."
    },
    {
      "id": "history",
      "label": "History and data",
      "help": "What the room records."
    },
    {
      "id": "equipment",
      "label": "Equipment and sizing",
      "help": "The room's hardware, substrate and probes."
    },
    {
      "id": "app",
      "label": "Controller app",
      "help": "Options of the controller app. Change them in the app's Configuration tab. They apply when the app restarts."
